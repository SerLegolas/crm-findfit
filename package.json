{
  "name": "crm-findfit-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo CRM FindFit (npm workspaces)",
  "workspaces": [
    "frontend",
    "backend",
    "shared"
  ],
  "scripts": {
    "dev": "concurrently -n frontend,backend -c blue,green \"npm:dev:frontend\" \"npm:dev:backend\"",
    "dev:frontend": "npm run dev --workspace frontend",
    "dev:backend": "npm run dev --workspace backend",
    "postinstall": "npm run build --workspace @crm/shared",
    "build:shared": "npm run build --workspace @crm/shared",
    "build": "npm run build --workspace @crm/shared && npm run build --workspace @crm/backend && npm run build --workspace frontend",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:generate": "npm run db:generate --workspace frontend",
    "db:push": "npm run db:push --workspace frontend",
    "db:migrate": "npm run db:migrate --workspace frontend",
    "db:studio": "npm run db:studio --workspace frontend",
    "db:migrate-multi-tenant": "npm run db:migrate-multi-tenant --workspace frontend",
    "menu:analyze": "npm run menu:analyze --workspace frontend",
    "menu:status": "npm run menu:status --workspace frontend",
    "menu:sync": "npm run menu:sync --workspace frontend"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "typescript": "^5.4.5"
  }
}
