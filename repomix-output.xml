│   │   ├── note/             # Note recenti
│   │   └── impostazioni/     # Impostazioni
│   ├── api/                  # API routes
│   │   ├── clients/          # CRUD clienti
│   │   ├── note/             # CRUD note
│   │   ├── tasks/            # CRUD task
│   │   └── dashboard/        # Dati dashboard
│   └── layout.tsx
├── components/
│   ├── ui/                   # Componenti shadcn/ui
│   ├── sidebar.tsx
│   ├── topbar.tsx
│   ├── status-badge.tsx
│   └── priority-badge.tsx
├── lib/
