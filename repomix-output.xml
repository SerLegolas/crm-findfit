  AlertDialogHeader,
  AlertDialogTitle,
  AlertDialogTrigger,
} from "@/components/ui/alert-dialog";
import { useToast } from "@/components/ui/use-toast";
import {
  Ban,
  CalendarClock,
  Eye,
  Loader2,
  MailOpen,
  MailPlus,
  Pencil,
  Plus,
  RefreshCw,
  Trash2,
} from "lucide-react";
import DatePicker from "react-datepicker";
import "react-datepicker/dist/react-datepicker.css";

type Stato =
  | "programmata"
  | "in_elaborazione"
  | "inviata"
  | "inviata_parziale"
  | "fallita"
  | "annullata";

interface BatchStats {
  total: number;
