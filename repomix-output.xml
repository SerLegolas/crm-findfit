  // 1. Rename _nn_users -> users (ha già NOT NULL e dati)
  console.log("1. Renaming _nn_users -> users...");
  await c.execute("DROP TABLE IF EXISTS users");
  await c.execute("ALTER TABLE \"_nn_users\" RENAME TO \"users\"");
