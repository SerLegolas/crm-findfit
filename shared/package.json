{
  "name": "@crm/shared",
  "version": "1.0.0",
  "private": true,
  "description": "Tipi e utility condivise (schema Drizzle) tra frontend e backend",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./db/schema": {
      "types": "./dist/db/schema.d.ts",
      "import": "./dist/db/schema.js",
      "default": "./dist/db/schema.js"
    },
    "./types/clients": {
      "types": "./dist/types/clients.d.ts",
      "import": "./dist/types/clients.js",
      "default": "./dist/types/clients.js"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.12.12",
    "typescript": "^5.4.5"
  }
}

